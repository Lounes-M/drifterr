# Secrets for the Drifterr edge functions. Set them in production with:
#   supabase secrets set --env-file supabase/functions/.env
# (SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected
#  automatically by the platform — you do NOT set those here.)
#
# The Stripe *price* ids are NOT secret and live in the database (the `plans`
# table, seeded by supabase/seed.sql), so they are not listed here.

# Where the user-facing site lives (used for Checkout success/cancel + CORS).
SITE_URL=https://drifterr.app

# Stripe — from the Stripe dashboard (use test keys while developing).
STRIPE_SECRET_KEY=sk_test_...
# After creating the webhook endpoint (see README), paste its signing secret:
STRIPE_WEBHOOK_SECRET=whsec_...
