# Drifterr proxy configuration.
# Copy to `.env` (auto-loaded from the working directory): cp .env.example .env

# Provider — plug Drifterr straight into a major AI provider, not only
# OpenRouter. Pick one preset; the proxy points the OpenAI-schema upstream at it:
#   openrouter (default) | openai | anthropic | gemini | groq | mistral |
#   deepseek | xai | together
# Then point your tool at the proxy with that provider's own key, e.g.:
#   OPENAI_BASE_URL=http://localhost:8787/v1   OPENAI_API_KEY=<your provider key>
# DRIFTERR_PROVIDER=openai

# For a fully custom / self-hosted endpoint, set the URL explicitly — this wins
# over DRIFTERR_PROVIDER. (Default when nothing is set: OpenRouter.)
# OPENAI_UPSTREAM=https://api.openai.com

# Upstream for Anthropic-style traffic (/v1/messages). Defaults to Anthropic
# direct; OpenRouter Claude models use the OpenAI-schema line above instead.
# ANTHROPIC_UPSTREAM=https://api.anthropic.com

# Listen addresses.
# DRIFTERR_PROXY_ADDR=127.0.0.1:8787
# DRIFTERR_CONTROL_ADDR=127.0.0.1:8788

# Persist sessions to SQLite (omit for in-memory only).
# DRIFTERR_DB=./drifterr.sqlite

# Claude Code file channel. Drifterr watches ~/.claude/projects automatically
# (zero config, no keys). Set this only to watch a DIFFERENT location.
# DRIFTERR_WATCH_DIR=~/.claude/projects/your-project

# Judge (fuzzy checks). Enabled when a key is present; uses OpenRouter.
# OPENROUTER_API_KEY=sk-or-...
# DRIFTERR_JUDGE_MODEL=openai/gpt-4o-mini

# Opt-in: auto-inject the re-anchor preamble into outgoing requests when a
# session is drifting (RED). This MODIFIES what you send — off by default.
# DRIFTERR_AUTO_REANCHOR=1

# --- local state ------------------------------------------------------------
# Where Drifterr keeps install-scoped state: the control-API token, and the
# database when the desktop app is not choosing the path. The desktop shell sets
# this to its own app-data dir so the app and the `hook`/`mcp` subprocesses can
# never disagree about where to look.
# DRIFTERR_STATE_DIR=~/.local/share/com.drifterr.app

# The control API is authenticated. Normally the token is generated on first run
# and read back from <state dir>/token (mode 0600); set this to pin one instead,
# e.g. in a container. `drifterr-proxy token` prints the live value.
# DRIFTERR_TOKEN=

# Extra origins allowed to READ a control-API response, comma-separated. The
# panel, the browser dashboard and browser extensions are already allowed; this
# is for a self-hosted dashboard on another port.
# DRIFTERR_ALLOWED_ORIGINS=https://ops.internal

# Delete stored sessions older than this many days. Unset keeps everything, which
# is what the product did before retention existed. This DELETES — it is not a
# display filter. The panel edits the same setting under Settings -> Your data.
# DRIFTERR_RETENTION_DAYS=30

# Public half of the key the accounts backend signs plan assertions with. Baked
# into release builds at compile time; unset means the proxy reports the plan as
# unverified rather than pretending it checked. See docs/ACCOUNTS.md.
# DRIFTERR_ENTITLEMENT_PUBKEY=
