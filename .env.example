# Drifterr proxy configuration.
# Copy to `.env` (auto-loaded from the working directory): cp .env.example .env

# Provider — plug Drifterr straight into a major AI provider, not only
# OpenRouter. Pick one preset; the proxy points the OpenAI-schema upstream at it:
#   openrouter (default) | openai | anthropic | gemini | groq | mistral |
#   deepseek | xai | together
# Then point your tool at the proxy with that provider's own key, e.g.:
#   OPENAI_BASE_URL=http://localhost:8787/v1   OPENAI_API_KEY=<your provider key>
# DRIFTERR_PROVIDER=openai

# For a fully custom / self-hosted endpoint, set the URL explicitly — this wins
# over DRIFTERR_PROVIDER. (Default when nothing is set: OpenRouter.)
# OPENAI_UPSTREAM=https://api.openai.com

# Upstream for Anthropic-style traffic (/v1/messages). Defaults to Anthropic
# direct; OpenRouter Claude models use the OpenAI-schema line above instead.
# ANTHROPIC_UPSTREAM=https://api.anthropic.com

# Listen addresses.
# DRIFTERR_PROXY_ADDR=127.0.0.1:8787
# DRIFTERR_CONTROL_ADDR=127.0.0.1:8788

# Persist sessions to SQLite (omit for in-memory only).
# DRIFTERR_DB=./drifterr.sqlite

# Watch a directory of Claude Code sessions (the file channel).
# DRIFTERR_WATCH_DIR=~/.claude/projects/your-project

# Judge (fuzzy checks). Enabled when a key is present; uses OpenRouter.
# OPENROUTER_API_KEY=sk-or-...
# DRIFTERR_JUDGE_MODEL=openai/gpt-4o-mini

# Opt-in: auto-inject the re-anchor preamble into outgoing requests when a
# session is drifting (RED). This MODIFIES what you send — off by default.
# DRIFTERR_AUTO_REANCHOR=1
