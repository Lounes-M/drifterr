# Drifterr proxy configuration.
# Copy to `.env` (auto-loaded from the working directory): cp .env.example .env

# Upstream for OpenAI-style traffic (/v1/chat/completions). Drifterr defaults to
# OpenRouter — it speaks the OpenAI schema and covers every model. Point your
# agent/tool at the proxy with your OpenRouter key:
#   OPENAI_BASE_URL=http://localhost:8787/v1
#   OPENAI_API_KEY=sk-or-...
OPENAI_UPSTREAM=https://openrouter.ai/api

# Upstream for Anthropic-style traffic (/v1/messages). Leave as-is unless you
# call the Anthropic API directly (OpenRouter Claude models use the line above).
# ANTHROPIC_UPSTREAM=https://api.anthropic.com

# Listen addresses.
# DRIFTERR_PROXY_ADDR=127.0.0.1:8787
# DRIFTERR_CONTROL_ADDR=127.0.0.1:8788

# Persist sessions to SQLite (omit for in-memory only).
# DRIFTERR_DB=./drifterr.sqlite
